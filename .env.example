# Copy to .env.local (git-ignored). Only EXPO_PUBLIC_* values are bundled into the app,
# so NEVER put a service-role / secret key here.
#
# Local stack (`npx supabase start`, then `npx supabase status` for the values):
#   - iOS simulator / web:      http://127.0.0.1:54321
#   - Android emulator:         http://10.0.2.2:54321
#   - Physical device (Expo Go): http://<your-LAN-IP>:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY=<publishable-or-anon-key>
