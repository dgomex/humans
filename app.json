{
  "expo": {
    "name": "Humans",
    "slug": "humans",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "humans",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.humans.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D62976",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.humans.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 88,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Humans uses your photo library so you can choose a profile picture and share photos.",
          "cameraPermission": "Humans uses your camera so you can take a profile picture and share photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Humans uses your camera to take photos and scan QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Humans saves images, like your QR code, to your photo library.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Humans uses your contacts to help you find people you know. Contacts are matched using one-way hashes of email addresses."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
